# Carpeta de fotos de bordados (solo lectura)
DESIGNS_DIR="C:\Users\Diego Benavides\Desktop\Embroidery supper pack\1. JUST PHOTOS of all designs"
# Archivos de máquina opcionales
MACHINE_FILES_DIR="C:\Users\Diego Benavides\Desktop\TOEmbroider"

# xdopestore-api (usar QA hasta 3 lotes correctos)
XDOPE_API_URL=
XDOPE_API_ENV=qa
XDOPE_AGENT_EMAIL=
XDOPE_AGENT_PASSWORD=
# admin-dashboard, para el enlace de edición del producto creado
XDOPE_ADMIN_URL=
# precio, tallas, categorías base (copia config/defaults.example.json)
DEFAULTS_FILE=config/defaults.json

# Cloudinary (subida de diseños a xdope-designs/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Generación de imágenes
IMAGE_PROVIDER=gemini
# Calidad por defecto de los lotes: economica (Nano Banana original, por defecto), baja (1K), media (2K) o alta (2K + reintento con Pro)
IMAGE_QUALITY=economica
IMAGE_OUTPUT_SIZE=1080x1350
# Todo va en batch de Gemini (mitad de precio); false = genera al momento
IMAGE_USE_BATCH=true
GEMINI_API_KEY=
# Respaldo
BFL_API_KEY=

# LLM para análisis de imagen, prompts y copy
ANTHROPIC_API_KEY=
# Modelo de Claude de los agentes: claude-sonnet-5-5 (por defecto), claude-opus-5-5 o claude-haiku-4-5
CLAUDE_MODEL=claude-sonnet-5-5

# Tope de gasto en imágenes por producto (USD)
MAX_IMAGE_COST_PER_PRODUCT=3

{
  "name": "xdope-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Agentes para publicar hoodies bordados en xDope",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "pipeline:legacy": "node src/pipeline.cjs",
    "scan": "node src/catalog/scan.cjs",
    "scan:library": "tsx --env-file-if-exists=.env src/cli/scan.ts",
    "schedule:install:legacy": "node src/scheduler/install.cjs",
    "schedule:remove": "node src/scheduler/install.cjs --remove",
    "schedule:preview": "tsx src/cli/schedule-preview.ts",
    "trial": "tsx --env-file-if-exists=.env src/cli/trial.ts",
    "pipeline": "tsx --env-file-if-exists=.env src/cli/pipeline.ts",
    "schedule:install": "tsx src/cli/schedule-install.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.130.0",
    "@google/genai": "^2.24.0",
    "croner": "^9.1.0",
    "dotenv": "^18.0.5",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
